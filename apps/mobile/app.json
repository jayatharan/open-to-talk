{
  "expo": {
    "name": "open2talk",
    "slug": "open2talk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "open2talk",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "org.open2talk.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSLocalNetworkUsageDescription": "open2talk connects to self-hosted servers on your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f4fd8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.open2talk.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0f12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "open2talk uses your camera for video calls.",
          "microphonePermission": "open2talk uses your microphone for calls."
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "# react-native-webrtc: its native library looks these classes up by name when it loads\n# (JNI_OnLoad), so R8 must keep them. libwebrtc.jar also ships jni_zero and a generated `J` class.\n-keep class org.webrtc.** { *; }\n-keep class org.jni_zero.** { *; }\n-keep class J.** { *; }\n-keep class com.oney.WebRTCModule.** { *; }\n-dontwarn org.webrtc.**\n-dontwarn org.jni_zero.**\n-dontwarn J.**"
          },
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      "./plugins/withScreenShare",
      "./plugins/withBroadcastExtension"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0d0f12"
  }
}
