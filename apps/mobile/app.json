{
  "expo": {
    "name": "open2talk",
    "slug": "open2talk",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "open2talk",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.open2talk.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSLocalNetworkUsageDescription": "open2talk connects to self-hosted servers on your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0f12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.open2talk.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0f12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "open2talk uses your camera for video calls.",
          "microphonePermission": "open2talk uses your microphone for calls."
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      "./plugins/withScreenShare",
      "./plugins/withBroadcastExtension"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0d0f12"
  }
}
