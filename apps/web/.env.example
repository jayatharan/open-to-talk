# Comma-separated STUN servers (default: Google's public STUN)
STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN relay (recommended for users behind strict NATs, e.g. mobile data / hotspots).
# Option A: Cloudflare Realtime TURN (hosted, 1,000 GB/month free). Create a TURN key in the
# Cloudflare dashboard under Realtime > TURN, and paste its Key ID and API token here.
# Both stay on the server; clients only receive short-lived credentials.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Option B: self-hosted coturn with `use-auth-secret` + `static-auth-secret=<TURN_SECRET>`.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=change-me
# TURN_TTL_SECONDS=3600

# Max simultaneous connections per room (mesh gets heavy past ~6 video peers)
MAX_PEERS_PER_ROOM=8
