# Comma-separated STUN servers (default: Google's public STUN)
STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN relay (recommended for users behind strict NATs).
# Use coturn with `use-auth-secret` + `static-auth-secret=<TURN_SECRET>`.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=change-me
# TURN_TTL_SECONDS=3600

# Max simultaneous connections per room (mesh gets heavy past ~6 video peers)
MAX_PEERS_PER_ROOM=8
